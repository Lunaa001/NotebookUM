# Aplicación
APP_NAME=NotebookUM
VERSION=1.2.0
DEBUG=true

# Servidor
HOST=0.0.0.0
PORT=8000

# CORS - Orígenes permitidos
ALLOWED_ORIGINS=["*"]

# Base de datos - PostgreSQL
DATABASE_URL=postgresql+psycopg://notebookum:notebookum123@localhost:5432/notebookum

# AI API - OpenAI-compatible API from UM AI Cloud
# URL: https://ai.cloud.um.edu.ar
# Get your key from: OpenWebUI Perfil -> Ajustes -> Cuenta -> Claves API
OPENAI_API_KEY=sk-your-um-api-key-here
OPENAI_MODEL=gemma4-26b

# File Upload Configuration
MAX_UPLOAD_SIZE=10485760

# Security
SECRET_KEY=your-secret-key-here

